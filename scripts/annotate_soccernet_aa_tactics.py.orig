"""Prepare and validate resume-safe Codex pre-annotations for SoccerNet-AA."""

from __future__ import annotations

import argparse
import csv
import fcntl
from fractions import Fraction
import hashlib
import io
import json
import math
from pathlib import Path
import re
import subprocess
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
DEFAULT_DATA_ROOT = ROOT / "data/SoccerNet-AA"
DEFAULT_VOCABULARY = ROOT / "data/annotations/战术词条表.csv"
DEFAULT_OUTPUT_DIR = ROOT / "outputs/soccernet_aa_tactics"
DEFAULT_KEEP_LIST = ROOT / "outputs/soccernet_aa_screening/screen_keeps.txt"
DEFAULT_TEMP_DIR = Path("/tmp/soccernet_aa_tactics")
EXPECTED_COUNTS = {"train": 4587, "valid": 1169}
EXPECTED_KEEP_COUNTS = {"train": 3363, "valid": 871}
FPS = 25
FRAME_COUNT = 750
BOARD_COUNT = 30
METHOD = "30x25_frame_contact_sheets+evidence_zoom"
CONFIDENCES = {"低", "中", "中高", "高"}
VALID_CONFIDENCES = {"低", "中", "高"}
VALID_KEEP_CSV_NAME = "codex_preannotations_valid_reverse.csv"
VALID_KEEP_REFRESH_INTERVAL = 20
RUN_NAME = "train_forward_low"
RUN_MAX_AA = 2293
# ponytail: temporary single-owner gate; remove after the low train partition completes.
RUN_OWNER_SHA256 = "844f64403ab7d9589a57144e7221036b6343fc9d79121990343f6b03a4fd1649"
ID_RE = re.compile(r"(train|valid)/AA-([1-9]\d*)")
HEX64_RE = re.compile(r"[0-9a-f]{64}")


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def write_text(path: Path, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.tmp")
    temporary.write_text(value, encoding="utf-8")
    temporary.replace(path)


def write_json(path: Path, value: Any) -> None:
    write_text(path, json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n")


def source_rows(data_root: Path, *, verify_counts: bool = True) -> list[dict[str, str]]:
    rows = []
    for split in ("train", "valid"):
        paths = sorted(
            (data_root / split).glob("AA-*.mp4"),
            key=lambda path: int(path.stem.split("-")[1]),
        )
        numbers = [int(path.stem.split("-")[1]) for path in paths]
        if numbers != list(range(1, len(paths) + 1)):
            raise ValueError(f"{split} AA numbering is not contiguous")
        if verify_counts and len(paths) != EXPECTED_COUNTS[split]:
            raise ValueError(
                f"{split}: expected {EXPECTED_COUNTS[split]} videos, found {len(paths)}"
            )
        for path in paths:
            try:
                video_path = path.relative_to(ROOT).as_posix()
            except ValueError:
                video_path = path.as_posix()
            rows.append({"id": f"{split}/{path.stem}", "video_path": video_path})
    return rows


def load_keep_ids(
    path: Path,
    sources: list[dict[str, str]],
    *,
    expected_count: int | None = 4234,
) -> set[str]:
    ids = [line.strip() for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]
    if expected_count is not None and len(ids) != expected_count:
        raise ValueError(f"expected {expected_count} keep ids, found {len(ids)}")
    if len(ids) != len(set(ids)) or any(not ID_RE.fullmatch(clip_id) for clip_id in ids):
        raise ValueError("keep list contains duplicate or invalid ids")
    known = {row["id"] for row in sources}
    if unknown := set(ids) - known:
        raise ValueError(f"keep list references unknown ids: {sorted(unknown)}")
    if expected_count is not None:
        for split, expected in EXPECTED_KEEP_COUNTS.items():
            found = sum(clip_id.startswith(f"{split}/") for clip_id in ids)
            if found != expected:
                raise ValueError(f"expected {expected} {split} keep ids, found {found}")
    return set(ids)


def select_sources(
    sources: list[dict[str, str]],
    *,
    split: str | None = None,
    keep_ids: set[str] | None = None,
    max_aa: int | None = None,
) -> list[dict[str, str]]:
    return [
        row for row in sources
        if (split is None or row["id"].startswith(f"{split}/"))
        and (keep_ids is None or row["id"] in keep_ids)
        and (max_aa is None or int(row["id"].split("-")[1]) <= max_aa)
    ]


def load_vocabulary(path: Path, expected_count: int | None = 46) -> dict[str, dict[str, str]]:
    cards = {}
    with path.open(encoding="utf-8-sig", newline="") as handle:
        for row in csv.DictReader(handle):
            priority = (row.get("优先级") or "").strip()
            if priority not in {"P0", "P1"}:
                continue
            tactic_id = (row.get("id（英文标识）") or "").strip()
            name = (row.get("中文名（填进 tactics 列）") or "").strip()
            if not tactic_id or not name or tactic_id in cards:
                raise ValueError(f"invalid or duplicate tactic row: {tactic_id!r}")
            cards[tactic_id] = {
                "name_zh": name,
                "priority": priority,
                "definition": (row.get("一句话定义") or "").strip(),
            }
    if expected_count is not None and len(cards) != expected_count:
        raise ValueError(f"expected {expected_count} P0/P1 tactics, found {len(cards)}")
    return cards


def frame_range(start_frame: int, end_frame: int) -> str:
    start_s = start_frame // FPS
    end_s = math.ceil((end_frame + 1) / FPS)
    return f"{start_s // 60:02d}:{start_s % 60:02d}–{end_s // 60:02d}:{end_s % 60:02d}"


def probe_video(path: Path) -> dict[str, Any]:
    result = subprocess.run(
        [
            "ffprobe", "-v", "error", "-select_streams", "v:0",
            "-show_entries", "stream=avg_frame_rate,nb_frames,width,height:format=duration",
            "-of", "json", str(path),
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    payload = json.loads(result.stdout)
    stream = payload["streams"][0]
    return {
        "fps": float(Fraction(stream["avg_frame_rate"])),
        "n_frames": int(stream["nb_frames"]),
        "width": int(stream["width"]),
        "height": int(stream["height"]),
        "duration_s": float(payload["format"]["duration"]),
    }


def prepare_clip(clip_id: str, video_path: Path, temp_root: Path) -> dict[str, Any]:
    if not ID_RE.fullmatch(clip_id):
        raise ValueError(f"invalid clip id: {clip_id}")
    info = probe_video(video_path)
    if (
        abs(info["fps"] - FPS) > 1e-6
        or info["n_frames"] != FRAME_COUNT
        or abs(info["duration_s"] - 30.0) > 0.01
        or (info["width"], info["height"]) != (1280, 720)
    ):
        raise ValueError(f"unexpected video metadata for {clip_id}: {info}")
    split, video_id = clip_id.split("/")
    target = temp_root / split / video_id
    target.mkdir(parents=True, exist_ok=True)
    for path in target.glob("board-*.jpg"):
        path.unlink()
    board_pattern = target / "board-%02d.jpg"
    subprocess.run(
        [
            "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
            "-i", str(video_path), "-an", "-vf",
            "scale=256:144,drawtext=text='f%{n}':x=4:y=4:fontsize=18:"
            "fontcolor=yellow:box=1:boxcolor=black@0.6,"
            "tile=5x5:nb_frames=25:padding=2:margin=2",
            "-frames:v", str(BOARD_COUNT), "-start_number", "0",
            str(board_pattern),
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    paths = sorted(target.glob("board-*.jpg"))
    if len(paths) != BOARD_COUNT:
        raise RuntimeError(f"expected {BOARD_COUNT} boards, found {len(paths)}")
    boards = [
        {
            "index": index,
            "start_frame": index * FPS,
            "end_frame": index * FPS + FPS - 1,
            "sha256": sha256(path),
            "path": path.relative_to(temp_root).as_posix(),
        }
        for index, path in enumerate(paths)
    ]
    manifest = {
        "id": clip_id,
        "video_path": video_path.as_posix(),
        "video_sha256": sha256(video_path),
        **info,
        "boards": boards,
    }
    write_json(target / "manifest.json", manifest)
    return manifest


def _integer_frames(value: Any, field: str, start: int, end: int, minimum: int = 1) -> None:
    if (
        not isinstance(value, list)
        or len(value) < minimum
        or len(set(value)) != len(value)
        or any(isinstance(frame, bool) or not isinstance(frame, int) or not start <= frame <= end for frame in value)
    ):
        raise ValueError(f"{field} must contain unique frames inside the tactic window")


def validate_review(
    review: Any,
    cards: dict[str, dict[str, str]],
    *,
    require_confidence: bool = False,
) -> dict[str, Any]:
    if not isinstance(review, dict) or not ID_RE.fullmatch(str(review.get("id", ""))):
        raise ValueError("invalid review id")
    if review.get("status") == "failed":
        if not isinstance(review.get("error"), str) or not review["error"].strip():
            raise ValueError("failed review requires an error")
        return review
    required = {
        "id", "video_sha256", "reviewer", "review_method", "status",
        "boards", "tactics", "negative_reason_zh",
    }
    if not required <= review.keys() or review.get("status") != "complete":
        raise ValueError("review fields or status are invalid")
    if not HEX64_RE.fullmatch(str(review["video_sha256"])):
        raise ValueError("invalid video sha256")
    if review["reviewer"] != "codex" or review["review_method"] != METHOD:
        raise ValueError("review provenance is invalid")
    boards = review["boards"]
    if not isinstance(boards, list) or len(boards) != BOARD_COUNT:
        raise ValueError("complete review requires 30 boards")
    for index, board in enumerate(boards):
        if (
            not isinstance(board, dict)
            or board.get("index") != index
            or board.get("start_frame") != index * FPS
            or board.get("end_frame") != index * FPS + FPS - 1
            or ("sha256" in board and not HEX64_RE.fullmatch(str(board["sha256"])))
        ):
            raise ValueError(f"invalid board coverage at index {index}")
    tactics = review["tactics"]
    if not isinstance(tactics, list):
        raise ValueError("tactics must be a list")
    allowed_confidences = (
        VALID_CONFIDENCES
        if require_confidence and review["id"].startswith("valid/")
        else CONFIDENCES
    )
    for tactic in tactics:
        required_tactic = {
            "tactic_id", "tactic_zh", "verdict", "start_frame", "end_frame",
            "evidence_frame_ids", "zoomed_frame_ids", "evidence_zh",
        }
        if not isinstance(tactic, dict) or not required_tactic <= tactic.keys():
            raise ValueError("invalid tactic fields")
        tactic_id = tactic["tactic_id"]
        if tactic_id not in cards or tactic["tactic_zh"] != cards[tactic_id]["name_zh"]:
            raise ValueError(f"tactic is outside the P0/P1 allowlist: {tactic_id}")
        if tactic["verdict"] not in {"present", "possible"}:
            raise ValueError("verdict must be present or possible")
        confidence = tactic.get("confidence")
        if (require_confidence or confidence is not None) and confidence not in allowed_confidences:
            raise ValueError("confidence is outside the allowed levels")
        if confidence == "低" and tactic["verdict"] != "possible":
            raise ValueError("low-confidence tactics must be possible")
        if confidence is not None and tactic["verdict"] == "possible" and confidence != "低":
            raise ValueError("possible tactics must have low confidence")
        start, end = tactic["start_frame"], tactic["end_frame"]
        if (
            isinstance(start, bool) or isinstance(end, bool)
            or not isinstance(start, int) or not isinstance(end, int)
            or not 0 <= start <= end < FRAME_COUNT
        ):
            raise ValueError("invalid tactic frame range")
        _integer_frames(tactic["evidence_frame_ids"], "evidence_frame_ids", start, end, 3)
        try:
            _integer_frames(tactic["zoomed_frame_ids"], "zoomed_frame_ids", start, end, 3)
        except ValueError as exc:
            raise ValueError("each tactic requires at least three zoomed frames") from exc
        if not isinstance(tactic["evidence_zh"], str) or not tactic["evidence_zh"].strip():
            raise ValueError("tactic evidence is empty")
    if not any(item["verdict"] == "present" for item in tactics):
        reason = review["negative_reason_zh"]
        if not isinstance(reason, str) or not reason.strip():
            raise ValueError("review without a present tactic requires negative_reason_zh")
        negative_confidence = review.get("negative_confidence")
        if negative_confidence not in {None, ""} and negative_confidence not in allowed_confidences:
            raise ValueError("negative confidence is outside the allowed levels")
        if tactics and negative_confidence not in {None, "", "低"}:
            raise ValueError("negative reviews with possible tactics must have low confidence")
    return review


def review_path(output_dir: Path, clip_id: str) -> Path:
    split, video_id = clip_id.split("/")
    return output_dir / "reviews" / split / f"{video_id}.json"


def record_review(
    manifest: dict[str, Any],
    tactics: list[dict[str, Any]],
    negative_reason_zh: str,
    negative_confidence: str,
    output_dir: Path,
    cards: dict[str, dict[str, str]],
    refuse_existing: bool = False,
) -> dict[str, Any]:
    review = validate_review({
        "id": manifest["id"],
        "video_sha256": manifest["video_sha256"],
        "reviewer": "codex",
        "review_method": METHOD,
        "status": "complete",
        "boards": [
            {key: board[key] for key in ("index", "start_frame", "end_frame", "sha256")}
            for board in manifest["boards"]
        ],
        "tactics": tactics,
        "negative_reason_zh": negative_reason_zh,
        "negative_confidence": negative_confidence,
    }, cards, require_confidence=True)
    path = review_path(output_dir, review["id"])
    if refuse_existing and path.is_file():
        existing = validate_review(json.loads(path.read_text(encoding="utf-8")), cards)
        if existing.get("status") == "complete" and existing.get("video_sha256") == review["video_sha256"]:
            return existing
        raise ValueError(f"refusing to overwrite conflicting review: {path}")
    write_json(path, review)
    return review


def next_id(
    output_dir: Path,
    sources: list[dict[str, str]],
    *,
    split: str | None = None,
    reverse: bool = False,
) -> str | None:
    selected = [row for row in sources if split is None or row["id"].startswith(f"{split}/")]
    for row in reversed(selected) if reverse else selected:
        path = review_path(output_dir, row["id"])
        if not path.is_file() or json.loads(path.read_text(encoding="utf-8")).get("status") != "complete":
            return row["id"]
    return None


def load_reviews(output_dir: Path, cards: dict[str, dict[str, str]]) -> dict[str, dict[str, Any]]:
    reviews = {}
    for path in sorted((output_dir / "reviews").glob("*/*.json")):
        review = validate_review(json.loads(path.read_text(encoding="utf-8")), cards)
        clip_id = review["id"]
        if clip_id in reviews or path != review_path(output_dir, clip_id):
            raise ValueError(f"duplicate or misplaced review: {path}")
        reviews[clip_id] = review
    return reviews


def _state(
    output_dir: Path,
    sources: list[dict[str, str]],
    cards: dict[str, dict[str, str]],
    *,
    known_ids: set[str] | None = None,
) -> tuple[dict[str, dict[str, Any]], list[str], list[str]]:
    reviews = load_reviews(output_dir, cards)
    selected = {row["id"] for row in sources}
    known = known_ids or selected
    if unknown := set(reviews) - known:
        raise ValueError(f"reviews reference unknown ids: {sorted(unknown)}")
    reviews = {clip_id: review for clip_id, review in reviews.items() if clip_id in selected}
    missing = [row["id"] for row in sources if row["id"] not in reviews]
    failed = [clip_id for clip_id, review in reviews.items() if review["status"] == "failed"]
    return reviews, missing, failed


def _export_outputs_unlocked(
    output_dir: Path,
    sources: list[dict[str, str]],
    cards: dict[str, dict[str, str]],
    *,
    target_sources: list[dict[str, str]] | None = None,
    known_ids: set[str] | None = None,
    reverse: bool = False,
    csv_name: str = "codex_preannotations.csv",
    source_filter: str = "all_videos",
    csv_only: bool = False,
    run_name: str = "",
    require_confidence: bool = False,
    require_complete: bool = False,
    provisional_confidence: str | None = None,
    exclude_tactic_ids: set[str] | None = None,
) -> dict[str, Any]:
    if provisional_confidence not in {None, "中", "中高", "高"}:
        raise ValueError("provisional confidence must be 中, 中高, or 高")
    selected_sources = target_sources or sources
    known_ids = known_ids or {row["id"] for row in sources}
    reviews, missing, failed = _state(output_dir, selected_sources, cards, known_ids=known_ids)
    if require_confidence or (
        selected_sources and all(row["id"].startswith("valid/") for row in selected_sources)
    ):
        for review in reviews.values():
            validate_review(
                review,
                cards,
                require_confidence=provisional_confidence is None,
            )
    if require_complete and (missing or failed):
        raise ValueError(f"run is incomplete: missing={len(missing)} failed={len(failed)}")
    csv_rows, queue = [], []
    present_count = possible_count = none_count = provisional_count = 0
    tactic_counts: dict[str, int] = {}
    excluded_tactic_ids = exclude_tactic_ids or set()
    source_by_id = {row["id"]: row for row in sources}
    for row in selected_sources:
        review = reviews.get(row["id"])
        if not review or review["status"] != "complete":
            continue
        candidates = sorted(
            review["tactics"],
            key=lambda item: (item["start_frame"], item["end_frame"], item["tactic_id"], item["verdict"]),
        )
        csv_candidates = [item for item in candidates if item["tactic_id"] not in excluded_tactic_ids]
        present = [item for item in csv_candidates if item["verdict"] == "present"]
        present_count += len(present)
        possible_count += len(csv_candidates) - len(present)
        if present:
            for item in present:
                confidence = item.get("confidence") or provisional_confidence or ""
                if not item.get("confidence") and provisional_confidence:
                    provisional_count += 1
                csv_rows.append({
                    "id": review["id"],
                    "战术": item["tactic_zh"],
                    "时间范围": frame_range(item["start_frame"], item["end_frame"]),
                    "判断依据": item["evidence_zh"].strip(),
                    "置信度": confidence,
                })
                tactic_counts[item["tactic_zh"]] = tactic_counts.get(item["tactic_zh"], 0) + 1
        else:
            none_count += 1
            negative_reason = review["negative_reason_zh"].strip()
            negative_confidence = review.get("negative_confidence", "")
            if not negative_reason and any(item["verdict"] == "present" for item in candidates):
                negative_reason = "排除暂不纳入的战术后，未见其他明确战术。"
                negative_confidence = "中"
            csv_rows.append({
                "id": review["id"],
                "战术": "无明确战术",
                "时间范围": "00:00–00:30",
                "判断依据": negative_reason,
                "置信度": negative_confidence,
            })
        if candidates:
            queue.append({
                "id": review["id"],
                "video_path": source_by_id[review["id"]]["video_path"],
                "video_sha256": review["video_sha256"],
                "candidates": candidates,
            })

    buffer = io.StringIO(newline="")
    writer = csv.DictWriter(buffer, fieldnames=["id", "战术", "时间范围", "判断依据", "置信度"], lineterminator="\n")
    writer.writeheader()
    writer.writerows(csv_rows)
    write_text(output_dir / csv_name, buffer.getvalue())
    if not csv_only:
        suffix = f"_{run_name}" if run_name else ""
        write_text(
            output_dir / f"doubao_candidates{suffix}.txt",
            "".join(f"{item['id']}\n" for item in queue),
        )
        write_text(
            output_dir / f"doubao_review_queue{suffix}.jsonl",
            "".join(json.dumps(item, ensure_ascii=False, sort_keys=True) + "\n" for item in queue),
        )
    complete = sum(review["status"] == "complete" for review in reviews.values())
    next_target_id = next_id(output_dir, selected_sources, reverse=reverse)
    target_splits = {row["id"].split("/", 1)[0] for row in selected_sources}
    target_split = next(iter(target_splits)) if len(target_splits) == 1 else "all"
    summary = {
        "material_passport": {
            "origin_skill": "experiment-agent",
            "origin_mode": "run",
            "origin_date": "2026-08-11",
            "verification_status": "UNVERIFIED",
            "version_label": "exp_result_v1",
        },
        "dataset": "SoccerNet-AA",
        "status": "complete" if complete == len(selected_sources) and not failed else "partial",
        "expected_count": len(selected_sources),
        "review_count": len(reviews),
        "complete_count": complete,
        "failed_count": len(failed),
        "missing_count": len(missing),
        "candidate_count": len(queue),
        "none_count": none_count,
        "present_count": present_count,
        "possible_count": possible_count,
        "split_complete_counts": {
            split: sum(clip_id.startswith(f"{split}/") and review["status"] == "complete" for clip_id, review in reviews.items())
            for split in ("train", "valid")
        },
        "provisional_confidence_count": provisional_count,
        "tactic_counts": dict(sorted(tactic_counts.items())),
        "failures": failed,
        "target_split": target_split,
        "source_filter": source_filter,
        "processing_order": "reverse" if reverse else "forward",
        "target_status": "complete" if next_target_id is None else "partial",
        "next_id": next_target_id,
        "limitations": [
            "Frame-board logs prove presentation, not internal model attention.",
            "The user waived the calibration pilot; tactical accuracy is unverified.",
            "Outputs are model-generated pre-annotations, not human ground truth.",
        ],
    }
    if run_name:
        summary["run_name"] = run_name
    if not csv_only:
        write_json(output_dir / f"summary{suffix}.json", summary)
    return summary



def export_outputs(
    output_dir: Path,
    sources: list[dict[str, str]],
    cards: dict[str, dict[str, str]],
    **kwargs: Any,
) -> dict[str, Any]:
    """Export under the shared publish lock only for the canonical CSV."""
    if kwargs.get("csv_name", "codex_preannotations.csv") != "codex_preannotations.csv":
        return _export_outputs_unlocked(output_dir, sources, cards, **kwargs)
    output_dir.mkdir(parents=True, exist_ok=True)
    with (output_dir / ".publish.lock").open("a+", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return _export_outputs_unlocked(output_dir, sources, cards, **kwargs)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--data-root", type=Path, default=DEFAULT_DATA_ROOT)
    parser.add_argument("--vocabulary", type=Path, default=DEFAULT_VOCABULARY)
    parser.add_argument("--output-dir", type=Path, default=DEFAULT_OUTPUT_DIR)
    parser.add_argument("--temp-dir", type=Path, default=DEFAULT_TEMP_DIR)
    parser.add_argument("--keep-list", type=Path, default=DEFAULT_KEEP_LIST)
    parser.add_argument("--run-name", choices=[RUN_NAME], default="")
    parser.add_argument("--owner-token", default="", help=argparse.SUPPRESS)
    commands = parser.add_subparsers(dest="command", required=True)
    prepare = commands.add_parser("prepare")
    prepare.add_argument("--id", required=True)
    prepare.add_argument("--valid-keep-only", action="store_true")
    record = commands.add_parser("record")
    record.add_argument("--id", required=True)
    record.add_argument("--valid-keep-only", action="store_true")
    record.add_argument("--tactic-json", action="append", default=[])
    record.add_argument("--negative-reason-zh", default="")
    record.add_argument("--negative-confidence", choices=sorted(CONFIDENCES), default="")
    next_command = commands.add_parser("next")
    next_command.add_argument("--split", choices=EXPECTED_COUNTS)
    next_command.add_argument("--reverse", action="store_true")
    next_command.add_argument("--keep-only", action="store_true")
    validate = commands.add_parser("validate")
    validate.add_argument("--require-complete", action="store_true")
    validate.add_argument("--split", choices=EXPECTED_COUNTS)
    validate.add_argument("--keep-only", action="store_true")
    validate.add_argument("--require-confidence", action="store_true")
    export = commands.add_parser("export")
    export.add_argument("--require-complete", action="store_true")
    export.add_argument("--split", choices=EXPECTED_COUNTS)
    export.add_argument("--reverse", action="store_true")
    export.add_argument("--keep-only", action="store_true")
    export.add_argument("--csv-name")
    export.add_argument("--csv-only", action="store_true")
    export.add_argument("--require-confidence", action="store_true")
    export.add_argument("--provisional-confidence", choices=["中", "中高", "高"])
    export.add_argument("--exclude-tactic-id", action="append", default=[])
    status = commands.add_parser("status")
    status.add_argument("--split", choices=EXPECTED_COUNTS)
    status.add_argument("--reverse", action="store_true")
    status.add_argument("--keep-only", action="store_true")
    return parser


def main() -> None:
    args = build_parser().parse_args()
    sources = source_rows(args.data_root)
    cards = load_vocabulary(args.vocabulary)
    write_id = getattr(args, "id", "")
    forward_write = (
        args.command in {"prepare", "record"}
        and bool(ID_RE.fullmatch(write_id))
        and write_id.startswith("train/")
        and int(write_id.rsplit("-", 1)[1]) <= RUN_MAX_AA
    )
    use_keep_ids = bool(args.run_name) or getattr(args, "keep_only", False) or getattr(args, "valid_keep_only", False) or forward_write
    keep_ids = load_keep_ids(
        args.keep_list,
        sources,
        expected_count=4234 if args.keep_list == DEFAULT_KEEP_LIST else None,
    ) if use_keep_ids else None
    if forward_write and write_id in keep_ids:
        owner_matches = hashlib.sha256(args.owner_token.encode()).hexdigest() == RUN_OWNER_SHA256
        if not args.run_name or not owner_matches:
            raise ValueError(f"train forward keep is owned by the active {RUN_NAME} turn: {write_id}")
    if args.run_name:
        targets = select_sources(sources, split="train", keep_ids=keep_ids, max_aa=RUN_MAX_AA)
        if args.temp_dir == DEFAULT_TEMP_DIR:
            args.temp_dir /= args.run_name
    else:
        targets = select_sources(sources, split=getattr(args, "split", None), keep_ids=keep_ids)
    target_ids = {row["id"] for row in targets}
    known_ids = {row["id"] for row in sources}
    if args.command == "prepare":
        if args.valid_keep_only and (not args.id.startswith("valid/") or args.id not in keep_ids):
            raise ValueError(f"id is outside valid keeps: {args.id}")
        if args.run_name and args.id not in target_ids:
            raise ValueError(f"id is outside {args.run_name}: {args.id}")
        source = next((row for row in sources if row["id"] == args.id), None)
        if source is None:
            raise ValueError(f"unknown id: {args.id}")
        path = Path(source["video_path"])
        if not path.is_absolute():
            path = ROOT / path
        print(json.dumps(prepare_clip(args.id, path, args.temp_dir), ensure_ascii=False))
    elif args.command == "record":
        if not ID_RE.fullmatch(args.id):
            raise ValueError(f"invalid clip id: {args.id}")
        if args.valid_keep_only and (not args.id.startswith("valid/") or args.id not in keep_ids):
            raise ValueError(f"id is outside valid keeps: {args.id}")
        if args.run_name and args.id not in target_ids:
            raise ValueError(f"id is outside {args.run_name}: {args.id}")
        split, video_id = args.id.split("/")
        manifest_path = args.temp_dir / split / video_id / "manifest.json"
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        if manifest.get("id") != args.id:
            raise ValueError(f"manifest id does not match: {manifest_path}")
        review = record_review(
            manifest,
            [json.loads(value) for value in args.tactic_json],
            args.negative_reason_zh,
            args.negative_confidence,
            args.output_dir,
            cards,
            refuse_existing=bool(args.run_name),
        )
        print(review_path(args.output_dir, review["id"]))
    elif args.command == "next":
        print(next_id(args.output_dir, targets, reverse=args.reverse) or "complete")
    elif args.command == "validate":
        reviews, missing, failed = _state(args.output_dir, targets, cards, known_ids=known_ids)
        if args.require_confidence:
            for review in reviews.values():
                validate_review(review, cards, require_confidence=True)
        selected = {row["id"] for row in targets}
        if args.require_complete and (missing or failed):
            raise ValueError(f"run is incomplete: missing={len(missing)} failed={len(failed)}")
        print(json.dumps({
            "split": args.split or "all",
            "review_count": sum(clip_id in selected for clip_id in reviews),
            "missing_count": len(missing),
            "failed_count": len(failed),
        }, ensure_ascii=False))
    elif args.command == "export":
        print(json.dumps(
            export_outputs(
                args.output_dir,
                targets,
                cards,
                known_ids=known_ids if args.keep_only or args.split or args.run_name else None,
                reverse=args.reverse,
                csv_name=args.csv_name or (
                    f"codex_preannotations_{args.run_name}.csv"
                    if args.run_name else "codex_preannotations.csv"
                ),
                source_filter=args.keep_list.name if args.keep_only or args.run_name else "all_videos",
                csv_only=args.csv_only,
                run_name=args.run_name,
                require_confidence=args.require_confidence,
                require_complete=args.require_complete,
                provisional_confidence=args.provisional_confidence,
                exclude_tactic_ids=set(args.exclude_tactic_id),
            ),
            ensure_ascii=False,
        ))
    else:
        reviews, missing, failed = _state(args.output_dir, targets, cards, known_ids=known_ids)
        selected = {row["id"] for row in targets}
        print(json.dumps({
            "split": args.split or "all",
            "expected_count": len(selected),
            "complete_count": sum(clip_id in selected and review["status"] == "complete" for clip_id, review in reviews.items()),
            "failed_count": len(failed),
            "missing_count": len(missing),
            "next_id": next_id(args.output_dir, targets, reverse=args.reverse),
        }, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
